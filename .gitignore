#####################################################
#             Development Configuration             #
#####################################################
.env
/carl.toml
/edgar.toml
.env*
.ci/deploy/localenv/data/secrets/
## keep the local development environment file
!.ci/deploy/localenv/.env.development
# Explicitly ignore the override file for docker-compose in localenv and testenv
.ci/deploy/localenv/docker-compose.override.yml
.ci/deploy/testenv/edgar/docker-compose.override.yml

#####################################################
#             Build, Binaries and Libs              #
#####################################################
/target/
opendut-lea/dist/
.vagrant/
/doc/book/
/doc/src/mdbook-plantuml-img
/doc/.mdbook-plantuml-cache
rustc-ice-*
.cache_ggshield

#####################################
#                Logs               #
#####################################
*.log
/docker-logs*/

# NetBird proto files get downloaded from the web.
/opendut-edgar/netbird-client-api/proto/netbird-v*

#####################################################
#        Bindings autogenerated by WASM             #
#####################################################
/opendut-edgar/plugin-api/src/bindings.rs

#####################################################
#                      IntelliJ                     #
#####################################################
*.iml
.idea/
.run

#####################################################
#                OS generated files                 #
#####################################################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
.directory

