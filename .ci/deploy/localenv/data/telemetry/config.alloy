discovery.docker "docker_logs_scrape" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"

	filter {
		name   = "label"
		values = ["logging=alloy"]
	}
}

loki.process "docker_logs_scrape" {
	forward_to = [loki.write.default.receiver]

	stage.match {
		selector = "{job=~\"traefik\"}"

		stage.static_labels {
			values = {
				service_name = "opendut-traefik",
				severity_text = "DEFAULT",
			}
		}

		stage.json {
			expressions = {
				ClientAddr     = "ClientAddr",
				RequestHost    = "RequestHost",
				RequestPath    = "RequestPath",
				ServiceName    = "ServiceName",
				entryPointName = "entryPointName",
				severity_text  = "level",
				message        = "msg",
				time           = "time",
			}
		}

		stage.template {
			source   = "severity_text"
			template = "{{ ToUpper .Value }}"
		}

		stage.timestamp {
			source = "time"
			format = "RFC3339"
		}

		stage.labels {
			values = {
				ClientAddr     = null,
				RequestHost    = null,
				RequestPath    = null,
				ServiceName    = null,
				entryPointName = null,
				severity_text  = null,
				message        = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"netbird-coturn\"}"

		stage.static_labels {
			values = {
				service_name = "opendut-netbird-coturn",
				severity_text = "DEFAULT",
			}
		}

		stage.regex {
			expression = "(?P<time>.+): \\((?P<thread>[0-9]+)\\): (?P<severity_text>[A-Z]+):( session (?P<session>[0-9]+):)? (?P<message>.*)"
		}

		stage.timestamp {
			source = "time"
			format = "RFC3339"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				severity_text   = null,
				session = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"netbird-management\"}"

		stage.static_labels {
			values = {
				service_name = "opendut-netbird-management",
				severity_text = "DEFAULT",
			}
		}

		stage.regex {
			expression = "(?P<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z) (?P<severity_text>[A-Z]+) (?P<message>.*)"
		}

		stage.timestamp {
			source = "timestamp"
			format = "RFC3339"
		}

		stage.template {
			source   = "severity_text"
			template = "{{ regexReplaceAllLiteral \"ERRO\" .severity_text \"ERROR\" }}"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				severity_text = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"keycloak\"}"

		stage.static_labels {
			values = {
				service_name = "opendut-keycloak",
				severity_text = "DEFAULT",
			}
		}

		stage.regex {
			expression = "(?P<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}.[0-9]+[A-Z]+)\\s+(?P<severity_text>[A-Z]+)\\s+\\[(?P<category>[^\\]]+)\\] \\((?P<thread>[^\\)]+)\\) (?P<message>.*)"
		}

		stage.timestamp {
			source = "timestamp"
			format = "RFC3339"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				category = null,
				severity_text    = null,
				thread   = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"keycloak-init\"}"

		stage.static_labels {
			values = {
				service_name = "opendut-keycloak-init",
				severity_text = "DEBUG",
			}
		}

		stage.regex {
			expression = "^(?P<severity_text>WARNING|INFO|DEBUG|ERROR|WARN)?(:\\s)*(?P<message>.+)"
		}

		stage.drop {
			expression = "^\\s*$"
		}

		stage.template {
			source   = "severity_text"
			template = "{{ regexReplaceAllLiteral \"WARNING\" .severity_text \"WARN\" }}"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				severity_text = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"netbird-signal\"}"

		stage.static_labels {
			values = {
			    service_name = "opendut-netbird-signal",
				severity_text = "DEFAULT",
			}
		}

		stage.regex {
			expression = "(?P<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z) (?P<severity_text>[A-Z]+) (?P<location>[^:]+:\\d+): (?P<message>.*)"
		}

		stage.timestamp {
			source = "timestamp"
			format = "RFC3339"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				severity_text   = null,
				location        = null,
			}
		}
	}

	stage.match {
		selector = "{job=~\"keycloak-postgres\"}"

		stage.static_labels {
			values = {
			    service_name = "opendut-keycloak-postgres",
				severity_text = "DEFAULT",
			}
		}

		stage.multiline {
			firstline = "^\\d{4}-\\d{2}-\\d{2}"
			max_lines = 0
		}

		stage.regex {
			expression = "^(?P<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]+ [A-Z]+) \\[[0-9]+\\] (?P<severity_text>[A-Z]+):  (?P<message>.*)$"
		}

		stage.template {
			source   = "severity_text"
			template = "{{ regexReplaceAllLiteral \"DETAIL|STATEMENT|DEBUG1|DEBUG2|DEBUG3|DEBUG4|DEBUG5|DEBUG\" .severity_text \"DEBUG\" }}"
		}

		stage.template {
			source   = "severity_text"
			template = "{{ regexReplaceAllLiteral \"INFO|NOTICE|LOG\" .severity_text \"INFO\" }}"
		}

		stage.template {
			source   = "severity_text"
			template = "{{ regexReplaceAllLiteral \"ERROR|FATAL|PANIC\" .severity_text \"ERROR\" }}"
		}

		stage.timestamp {
			source = "timestamp"
			format = "RFC3339"
		}

		stage.output {
			source = "message"
		}

		stage.labels {
			values = {
				severity_text = null,
			}
		}
	}
}

discovery.relabel "docker_logs_scrape" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "logstream"
	}

	rule {
		source_labels = ["__meta_docker_container_label_logging_job"]
		target_label  = "job"
	}
}

loki.source.docker "docker_logs_scrape" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.docker_logs_scrape.targets
	forward_to       = [loki.process.docker_logs_scrape.receiver]
	relabel_rules    = discovery.relabel.docker_logs_scrape.rules
	refresh_interval = "5s"
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}
